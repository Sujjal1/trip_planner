# Copy to deploy/.env on the hosting server. Never commit real values.
# A hostname you control, with DNS pointing to the server. No https:// prefix.
APP_DOMAIN=
# Public browser key restricted to https://your-hostname/* and Maps Embed API.
VITE_GOOGLE_MAPS_API_KEY=
# Server-only keys; these are never placed in the frontend bundle.
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EIA_API_KEY=
