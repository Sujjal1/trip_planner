# Copy to backend/.env. Never commit real keys.
DATABASE_PATH=backend/codrive.sqlite3
COOKIE_SECURE=false
DEMO_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EIA_API_KEY=
# Production Google Places search: server-only key restricted to Places API (New)
# and your server IP. Local development can use frontend/.env's Maps key.
GOOGLE_PLACES_API_KEY=
APP_ORIGIN=http://localhost:8000
